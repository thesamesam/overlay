diff --git a/gas/testsuite/gas/cfi/cfi.exp b/gas/testsuite/gas/cfi/cfi.exp
index de518446a13..ef3c5a70ecd 100644
--- a/gas/testsuite/gas/cfi/cfi.exp
+++ b/gas/testsuite/gas/cfi/cfi.exp
@@ -34,6 +34,10 @@ proc gas_x86_32_check { } {
     return [regexp "targets:.*i386" [lindex $status 1]];
 }
 
+if { [gas_sframe_check] } then {
+    set NO_SFRAME_ASFLAGS "--gsframe=no"
+}
+
 if  { [istarget "i*86-*-*"] || [istarget "x86_64-*-*"] } then {
 
     global ASFLAGS
@@ -41,7 +45,7 @@ if  { [istarget "i*86-*-*"] || [istarget "x86_64-*-*"] } then {
 
     if { [gas_x86_64_check] } then {
 	set ASFLAGS "$ASFLAGS --64"
-	run_dump_test "cfi-x86_64"
+	run_dump_test "cfi-x86_64" "{as $NO_SFRAME_ASFLAGS}"
 	run_dump_test "cfi-x86_64-2"
 	set ASFLAGS "$old_ASFLAGS"
     }
@@ -54,7 +58,7 @@ if  { [istarget "i*86-*-*"] || [istarget "x86_64-*-*"] } then {
     }
 
     if { [is_elf_format] } then {
-	run_dump_test "cfi-label"
+	run_dump_test "cfi-label" "{as $NO_SFRAME_ASFLAGS}"
     }
 
     if { [is_pecoff_format] } then {
@@ -119,26 +123,26 @@ run_list_test "cfi-diag-1" ""
 
 # ARC and HPPA use ';' as comment char rather than as statement separator.
 if { ![istarget "arc*-*-*"] && ![istarget "hppa*-*"] } then {
-    run_list_test "listing" "-aln --listing-cont-lines=1"
+    run_list_test "listing" "-aln --listing-cont-lines=1" "{as $NO_SFRAME_ASFLAGS}"
 }
 
 # HPPA64 uses 64-bit relocations, which results in all of the dump
 # offset numbers not matching up.
 if { ![istarget "hppa64*-*"] } then {
-  run_dump_test "cfi-common-1"
-  run_dump_test "cfi-common-2"
-  run_dump_test "cfi-common-3"
-  run_dump_test "cfi-common-4"
+  run_dump_test "cfi-common-1" "{as $NO_SFRAME_ASFLAGS}"
+  run_dump_test "cfi-common-2" "{as $NO_SFRAME_ASFLAGS}"
+  run_dump_test "cfi-common-3" "{as $NO_SFRAME_ASFLAGS}"
+  run_dump_test "cfi-common-4" "{as $NO_SFRAME_ASFLAGS}"
   if { ![is_pecoff_format] } then {
     # This test uses .subsection/.previous which are elf-specific.
-    run_dump_test "cfi-common-5"
+    run_dump_test "cfi-common-5" "{as $NO_SFRAME_ASFLAGS}"
   }
   # Some targets don't support PC relative cfi directives
   if { ![istarget "mips*-*"] } then {
-    run_dump_test "cfi-common-6"
+    run_dump_test "cfi-common-6" "{as $NO_SFRAME_ASFLAGS}"
   }
-  run_dump_test "cfi-common-7"
-  run_dump_test "cfi-common-8"
+  run_dump_test "cfi-common-7" "{as $NO_SFRAME_ASFLAGS}"
+  run_dump_test "cfi-common-8" "{as $NO_SFRAME_ASFLAGS}"
   run_dump_test "cfi-common-9"
   if { [is_elf64 tmpdir/cfi-common-9.o] } {
       run_dump_test "cfi-common-10"
