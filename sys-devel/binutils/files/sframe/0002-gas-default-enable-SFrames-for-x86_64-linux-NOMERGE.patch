Message-ID: <47eeafde4d47f7d17b3c3ef5ce3488fc092bb2a6.1786945627.git.sam@gentoo.org>
In-Reply-To: <d6f74791bb508de3cd29f85c926c587cb7d5b4d2.1786945627.git.sam@gentoo.org>
References: <d6f74791bb508de3cd29f85c926c587cb7d5b4d2.1786945627.git.sam@gentoo.org>
From: Sam James <sam@gentoo.org>
Date: Sat, 26 Jul 2025 00:09:57 +0100
Subject: [PATCH 2/5] gas: default-enable SFrames for x86_64-*-linux-*
 [NOMERGE]

(I don't intend for this to be merged at this point, I've just included
it for testing.)

gas/
	PR gas/33126
	* configure: Regenerate.
	* configure.ac (ac_default_sframe): Initialize to 1 for
	x86_64-*-linux-*.

Signed-off-by: Sam James <sam@gentoo.org>
---
 gas/configure    | 7 +++++++
 gas/configure.ac | 7 +++++++
 2 files changed, 14 insertions(+)

diff --git a/gas/configure b/gas/configure
index 8afaf2729ed..5b8e15c3d24 100755
--- a/gas/configure
+++ b/gas/configure
@@ -12540,6 +12540,13 @@ $as_echo "#define STRICTCOFF 1" >>confdefs.h
 	   && test ${ac_default_generate_x86_used_note} = unset; then
 	  ac_default_generate_x86_used_note=1
 	fi
+
+	# If unset on x86_64-*-linux-*, let's enable it.
+	if test ${this_target} = $target \
+	   && test ${ac_default_sframe} = unset; then
+	  ac_default_sframe=1
+	fi
+
 	;;
 
       microblaze*)
diff --git a/gas/configure.ac b/gas/configure.ac
index 4dc7c019ce2..1a389820ed7 100644
--- a/gas/configure.ac
+++ b/gas/configure.ac
@@ -272,6 +272,13 @@ for this_target in $target $canon_targets ; do
 	   && test ${ac_default_generate_x86_used_note} = unset; then
 	  ac_default_generate_x86_used_note=1
 	fi
+
+	# If unset on x86_64-*-linux-*, let's enable it.
+	if test ${this_target} = $target \
+	   && test ${ac_default_sframe} = unset; then
+	  ac_default_sframe=1
+	fi
+
 	;;
 
       microblaze*)
